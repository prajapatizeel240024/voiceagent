# Caddy reverse proxy — terminates HTTPS, forwards to Node backend on :3000.
# Uses nip.io for a free hostname that resolves to our VM's IP.
# CADDY_DOMAIN gets replaced by deploy.sh with the actual VM IP.
{$CADDY_DOMAIN} {
  reverse_proxy localhost:3000 {
    # WebSocket upgrade headers — required for /agent-ws and /stream
    header_up Host {host}
    header_up X-Real-IP {remote}
    header_up X-Forwarded-For {remote}
    header_up X-Forwarded-Proto {scheme}
  }

  # Logging
  log {
    output file /var/log/caddy/access.log
    format json
  }
}
